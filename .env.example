# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Required for text, stills, review and clips (the main path): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for narration: https://elevenlabs.io (Profile, API keys)
ELEVENLABS_API_KEY=

# Optional, only if the video provider rejects inline (data URL) first frames.
# A command that uploads {path} to storage YOU control and prints the public https URL last.
# MDK_UPLOAD_CMD=aws s3 cp {path} s3://my-bucket/mdk/{name} && echo https://my-bucket.s3.amazonaws.com/mdk/{name}
# MDK_UPLOAD_ALWAYS=1

# Optional, experimental Higgsfield backend (set production.backend: higgsfield in the bible).
# The Higgsfield CLI keeps its own login: run `higgsfield auth login` once. No key goes here.
# Path to the CLI if it is not on your PATH:
# HIGGSFIELD_BIN=/usr/local/bin/higgsfield
